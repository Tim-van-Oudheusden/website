{
  "name": "website",
  "private": true,
  "type": "module",
  "workspaces": [
    "front-end",
    "back-end",
    "shared"
  ],
  "scripts": {
    "dev:front-end": "bun run --filter front-end dev",
    "dev:back-end": "bun run --filter back-end dev",
    "dev": "bun run dev:front-end & bun run dev:back-end",
    "build": "bun run --filter '*' build",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "test": "bun run --filter '*' test",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed --project=chromium",
    "typecheck:root": "tsc -p tsconfig.eslint.json --noEmit && tsc -p e2e/tsconfig.eslint.json --noEmit",
    "typecheck": "bun run --filter shared build && bun run --filter \"*\" typecheck && bun run typecheck:root"
  },
  "devDependencies": {
    "@eslint-react/eslint-plugin": "5.24.4",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "1.62.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/bun": "^1.4.0",
    "eslint": "^10.9.0",
    "eslint-plugin-perfectionist": "5.12.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.67.0"
  },
  "overrides": {
    "@hono/node-server": "^1.19.17",
    "body-parser": "^2.3.0",
    "brace-expansion": "^5.0.12",
    "browserslist": "^4.29.3",
    "esbuild": "^0.28.2",
    "find-my-way": "^9.9.0",
    "hono": "^4.13.4",
    "ip-address": "^10.5.0",
    "js-yaml": "^4.3.2",
    "nanoid": "^3.3.18",
    "postcss": "^8.5.26",
    "proxy-addr": "^2.0.8",
    "source-map-js": "^1.2.2"
  }
}
