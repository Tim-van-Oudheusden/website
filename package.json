{
  "name": "website",
  "private": true,
  "type": "module",
  "workspaces": [
    "front-end",
    "back-end",
    "shared"
  ],
  "scripts": {
    "dev:front-end": "bun run --filter front-end dev",
    "dev:back-end": "bun run --filter back-end dev",
    "dev": "bun run dev:front-end & bun run dev:back-end",
    "build": "bun run --filter '*' build",
    "lint": "eslint .",
    "test": "bun run --filter '*' test",
    "typecheck:root": "tsc -b --noEmit",
    "typecheck": "bun run --filter '*' typecheck && tsc -b --noEmit"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.3",
    "@stylistic/eslint-plugin": "^5.9.0",
    "@types/bun": "^1.3.9",
    "eslint": "^9.39.3",
    "shadcn": "^3.8.4",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.0"
  }
}
