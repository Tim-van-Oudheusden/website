{
  "name": "website",
  "private": true,
  "type": "module",
  "workspaces": [
    "front-end",
    "back-end",
    "shared"
  ],
  "scripts": {
    "dev:front-end": "bun run --filter front-end dev",
    "dev:back-end": "bun run --filter back-end dev",
    "dev": "bun run dev:front-end & bun run dev:back-end",
    "build": "bun run --filter '*' build",
    "lint": "eslint .",
    "typecheck": "bun run --filter '*' typecheck"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@stylistic/eslint-plugin": "^5.7.1",
    "@types/bun": "^1.3.8",
    "eslint": "^9.39.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.54.0"
  }
}
