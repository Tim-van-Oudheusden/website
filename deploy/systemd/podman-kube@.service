# Rootless systemd template unit that runs the production pod via
# `podman kube play`. Install to ~/.config/systemd/user/podman-kube@.service;
# the instance name is the pod's name ("website"):
#
#   cp deploy/systemd/podman-kube@.service ~/.config/systemd/user/
#   systemctl --user daemon-reload
#   systemctl --user enable --now podman-kube@website.service
#
# WEBSITE_REPO is the repository root on the host (only deploy/kube/prod.yaml
# and deploy/systemd/website-update.sh are read from it). The default below
# assumes ~/Git/website. website-update.service shares the same default; if the
# files live elsewhere, override BOTH units with identical drop-ins
# (docs/deploy.md §1), e.g. ~/.config/systemd/user/<unit>.d/override.conf:
#
#   [Service]
#   Environment=WEBSITE_REPO=%E/website
#
# website-update.service/.timer restart this unit (podman-kube@website) so a
# newly-pulled :latest image takes effect with no SSH/push from CI. The one-shot
# form + RemainAfterExit=yes keeps the unit "active" so `restart` (ExecStop
# then ExecStart) and reboot persistence both behave.

[Unit]
Description=Run the website production pod (podman kube play)
# The user manager has no network-online.target; podman ships this user-level
# wait (the same one Quadlet units use) so boot-time pulls see the network.
Wants=podman-user-wait-network-online.service
After=podman-user-wait-network-online.service

[Service]
Type=oneshot
RemainAfterExit=yes
Environment=WEBSITE_REPO=%h/Git/website
ExecStart=/usr/bin/podman kube play --replace ${WEBSITE_REPO}/deploy/kube/prod.yaml
ExecStop=/usr/bin/podman kube down ${WEBSITE_REPO}/deploy/kube/prod.yaml

[Install]
WantedBy=default.target