# Pull the latest images the prod pod runs, then replay the pod ONLY when an
# image actually changed (see website-update.sh). `podman auto-update` re-pulls
# images but does NOT re-apply Kube YAML; the conditional restart here makes a
# new :latest take effect with no SSH/push (the server pulls outbound-only) and
# without tearing the pod down on the common no-new-image cycle.
#
# The image refs in website-update.sh must match deploy/kube/prod.yaml exactly.
#
# WEBSITE_REPO must match podman-kube@.service's: the helper and the manifest
# come from the same checkout. Override both with drop-ins if it lives
# elsewhere (see docs/deploy.md §1).
#
# Rollback:
#   podman pull ghcr.io/tim-van-oudheusden/website/front-end:<git-sha>
#   podman pull ghcr.io/tim-van-oudheusden/website/back-end:<git-sha>
#   # point the pod manifest at <git-sha>, then:
#   systemctl --user restart podman-kube@website.service

[Unit]
Description=Pull latest website images and replay the prod pod when they change

[Service]
Type=oneshot
Environment=WEBSITE_REPO=%h/Git/website
ExecStart=/usr/bin/bash ${WEBSITE_REPO}/deploy/systemd/website-update.sh