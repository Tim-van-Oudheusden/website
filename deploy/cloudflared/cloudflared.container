# Rootless Quadlet for the Cloudflare Tunnel connector.
#
# The tunnel must be LOCALLY managed for config.yml's ingress rules to apply:
# create it with `cloudflared tunnel create <name>`. A dashboard-created
# "remotely managed" tunnel fetches its config from the edge and silently
# ignores config.yml. Obtain the token with `cloudflared tunnel token <name>`
# and store it in the env file below (host-side, 0600) — never in the repo or
# an image. See docs/deploy.md §2 for running `cloudflared` via this image on a
# host without the binary.
#
# Host-side files live under $XDG_CONFIG_HOME/cloudflared (%E = ~/.config):
# config.yml (copied from this directory) and cloudflared.env (TUNNEL_TOKEN=…).
# Install steps: docs/deploy.md §2. Quadlet units are generated, so `enable`
# does not apply: [Install] below makes the generator start it at boot.
# AutoUpdate=registry only acts when `podman-auto-update.timer` is enabled for
# the user.

[Unit]
Description=Cloudflare Tunnel (cloudflared)

[Container]
Image=docker.io/cloudflare/cloudflared:latest
AutoUpdate=registry
ContainerName=cloudflared
# cloudflared reaches the kube pod's loopback-published ports via the host's
# network namespace.
Network=host
EnvironmentFile=%E/cloudflared/cloudflared.env
# Z relabels the file so the container may read it on SELinux-enforcing hosts.
Volume=%E/cloudflared/config.yml:/etc/cloudflared/config.yml:ro,Z
# The image ENTRYPOINT is `cloudflared --no-autoupdate`; these args override
# its default CMD (`version`) to run the tunnel with our local ingress rules.
Exec=tunnel --config /etc/cloudflared/config.yml run

[Service]
Restart=on-failure
RestartSec=5s

[Install]
WantedBy=default.target