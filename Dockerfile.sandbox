FROM docker.io/oven/bun:1.3.14

# Install host tools pi commonly needs for repository work.
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
      bash \
      ca-certificates \
      curl \
      file \
      git \
      jq \
      less \
      npm \
      openssh-client \
      procps \
      ripgrep \
      unzip \
      zip && \
    rm -rf /var/lib/apt/lists/*

# Install pi as the non-root bun user. The oven/bun image sets
# BUN_INSTALL_BIN=/usr/local/bin, which the bun user cannot write to, so use a
# user-owned global bin directory and put it on PATH.
ENV BUN_INSTALL_BIN=/home/bun/.bun/bin
ENV PATH=/home/bun/.bun/bin:$PATH

USER bun
RUN mkdir -p /home/bun/.bun/bin /home/bun/.pi/agent /home/bun/.cache/bun && \
    bun install -g @earendil-works/pi-coding-agent && \
    bun install -g --trust @beads/bd@1.0.5 && \
    bun install -g superlocalmemory@3.5.5

USER root
RUN ln -sf /home/bun/.bun/bin/bd /usr/local/bin/bd && \
    ln -sf /home/bun/.bun/bin/pi /usr/local/bin/pi && \
    ln -sf /home/bun/.bun/bin/slm /usr/local/bin/slm && \
    ln -sf /home/bun/.bun/bin/superlocalmemory /usr/local/bin/superlocalmemory

USER bun

WORKDIR /workspace

CMD ["bun", "/home/bun/.bun/bin/pi"]
