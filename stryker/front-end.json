{
  "$schema": "../node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "mutate": [
    "front-end/src/**/*.{ts,tsx}",
    "front-end/server/**/*.ts",
    "!front-end/src/shared/components/ui/**",
    "!**/*.d.ts"
  ],
  "testRunner": "command",
  "commandRunner": {
    "command": "bun run --filter front-end test"
  },
  "coverageAnalysis": "off",
  "inPlace": true,
  "disableTypeChecks": false,
  "reporters": ["clear-text", "progress", "html", "json"],
  "htmlReporter": {
    "fileName": "reports/mutation/front-end.html"
  },
  "jsonReporter": {
    "fileName": "reports/mutation/front-end.json"
  }
}
