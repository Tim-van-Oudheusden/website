{
  "$schema": "../node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "mutate": ["back-end/src/**/*.ts"],
  "testRunner": "command",
  "commandRunner": {
    "command": "bun run --filter back-end test"
  },
  "coverageAnalysis": "off",
  "inPlace": true,
  "disableTypeChecks": false,
  "reporters": ["clear-text", "progress", "html", "json"],
  "htmlReporter": {
    "fileName": "reports/mutation/back-end.html"
  },
  "jsonReporter": {
    "fileName": "reports/mutation/back-end.json"
  }
}
